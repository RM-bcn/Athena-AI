# Groq API Key - Required for AI functionality
GROQ_API_KEY="jouw_hier_geplakte_groq_sleutel"

# App URL - The URL where this app is hosted
APP_URL="http://localhost:3000"

# Google Workspace / OAuth & Google Sheets Config
# Get these from Google Cloud Console:
# 1. Go to https://console.cloud.google.com/
# 2. Enable: Google Sheets API + Google Drive API
# 3. Create OAuth credentials (Web application)
# 4. Redirect URI: http://localhost:3000/auth/callback
CLIENT_ID="jouw_client_id_hier"
CLIENT_SECRET="jouw_client_secret_hier"
REFRESH_TOKEN="jouw_refresh_token_hier"

# Optional: ID of existing Google Sheet (if not set, Athena will automatically create/find "Athena AI - Cyclades Trip (ATH-2026)" in your Google Drive)
GOOGLE_SHEET_ID=""
