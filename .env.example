# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GROQ_API_KEY="MY_GROQ_API_KEY"

# GROQ_MODEL_PREFERENCE: handmatige model-voorkeur (komma-gescheiden).
# Leeg = automatisch gerankt uit de beschikbare actieve modellen van Groq.
# GROQ_MODEL_PREFERENCE="llama-3.3-70b-versatile,llama-3.1-8b-instant"

# GEMINI_MODEL: Gemini-model (default: gemini-3.6-flash).
# GEMINI_MODEL="gemini-3.6-flash"

# Live web search via DuckDuckGo (gratis, geen API-sleutel nodig).
# Zet op "false" om uit te schakelen.
DUCKDUCKGO_ENABLED="true"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, API endpoints, and the
# wachtwoordreset-link in de reset-mail (?reset=<token>). Fallback: http://localhost:3000.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: e-mailprovider voor de wachtwoordreset-mail.
# Zonder key verstuurt de server geen e-mail maar logt hij de reset-link naar
# de serverconsole (dev-modus), zodat de flow lokaal testbaar blijft.
RESEND_API_KEY="MY_RESEND_API_KEY"

# RESEND_FROM: afzender-adres dat bij Resend is geverifieerd (optioneel).
# Fallback: Athena AI <onboarding@resend.dev>
# RESEND_FROM="Athena AI <jouw@verified.domein>"

# SESSION_SECRET: Secret used to HMAC-sign the login token.
# Verplicht in productie (Vercel). Alleen lokaal/dev mag de afgeleide fallback gebruiken.
SESSION_SECRET="MY_SESSION_SECRET"

# Google Workspace / OAuth & Google Sheets Config
CLIENT_ID=
CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_Secret=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SHEET_ID=
